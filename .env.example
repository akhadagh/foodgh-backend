PORT=5000
NODE_ENV=development

# Database - use DATABASE_URL for Render/cloud, or individual vars for local
DATABASE_URL=postgresql://user:password@localhost:5432/food_ordering
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_ordering
DB_USER=postgres
DB_PASSWORD=your_password

# JWT - generate a random string for production
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS) - update to your deployed frontend URL
FRONTEND_URL=http://localhost:3000
