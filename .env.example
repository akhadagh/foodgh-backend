PORT=5000
NODE_ENV=development

# PostgreSQL - use DATABASE_URL for Render/cloud, or individual vars for local
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_ordering
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
